# Default: normalize line endings to LF on commit
* text=auto eol=lf

# Go source files
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts get CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Markdown and docs
*.md text eol=lf
*.txt text eol=lf

# Web
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Config / data formats
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.env text eol=lf

# Makefile (tabs are significant)
Makefile text eol=lf
makefile text eol=lf

# Binaries — no line-ending conversion, no diff
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
*.o binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.xz binary
*.7z binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
