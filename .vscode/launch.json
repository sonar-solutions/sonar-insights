{
    "configurations": [
        {
            "name": "collect",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "main.go",
            "args": ["collect", "--url", "${env:SONAR_HOST_URL}", "--token", "${env:SONAR_TOKEN}", "--out-dir", "./sonar-data/"],
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "analyze",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "main.go",
            "args": ["analyze", "--dir", "./sonar-data/", "--report-name", "sonar-insights-report"],
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "run",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "main.go",
            "args": ["run", "--url", "${env:SONAR_HOST_URL}", "--token", "${env:SONAR_TOKEN}", "--dir", "./sonar-data/", "--report-name", "sonar-insights-report"],
            "envFile": "${workspaceFolder}/.env"
        }
    ]
}
